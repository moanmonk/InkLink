rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProfile(data) {
      return data.id is string && data.id.size() <= 128
          && data.username is string && data.username.size() <= 100
          && data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidAuthUser(data) {
      return data.id is string && data.email is string && data.password is string;
    }

    function isValidSubmission(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.promptId is string && data.promptId.size() <= 128
          && data.imageUrl is string && data.imageUrl.size() <= 10000000;
    }

    // Collection match blocks
    
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isValidProfile(incoming());
      allow delete: if request.auth != null ? request.auth.uid == userId : true;
    }

    match /auth_users/{email} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if isValidSubmission(incoming());
      allow delete: if true;
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if incoming().userId is string && incoming().submissionId is string && incoming().rating is number;
      allow delete: if true;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create, update: if incoming().userId is string && incoming().submissionId is string;
      allow delete: if true;
    }

    match /friendships/{friendshipId} {
      allow read: if true;
      allow write: if true;
    }

    match /private_challenges/{challengeId} {
      allow read: if true;
      allow write: if true;
    }

    match /challenge_submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    match /featured_drawings/{drawingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
